<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns every app bar and surface; a platform ActionBar would overlap its semantics and touch bounds. -->
    <style name="LedgerActivityTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
