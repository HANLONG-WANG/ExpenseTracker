    <string name="global_notification_title">允许操作通知</string><string name="global_notification_rationale">通知用于显示导入、导出、备份、恢复和周期候选记录的长任务状态。拒绝不会阻止核心记账，但系统可能限制后台可见性。</string><string name="global_notification_denied">通知权限已拒绝。任务状态仍保存在加密操作中心，可在系统设置中重新允许。</string><string name="global_notification_granted">操作通知已允许。</string><string name="global_notification_continue">继续</string><string name="global_notification_not_now">暂不</string><string name="global_notification_open_settings">打开系统通知设置</string>
