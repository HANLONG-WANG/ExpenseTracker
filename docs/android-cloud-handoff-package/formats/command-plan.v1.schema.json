{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yohaku.example/formats/command-plan.v1.schema.json",
  "title": "Yohaku command-plan v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "yohaku.command-plan"
    },
    "version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "book_id": {
      "type": "string"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "message": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "command": {
                "const": "account.save"
              },
              "command_version": {
                "const": 1
              },
              "input": {
                "$ref": "#/$defs/account.save"
              }
            },
            "required": [
              "id",
              "command",
              "command_version",
              "input"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "command": {
                "const": "financialRule.addVersion"
              },
              "command_version": {
                "const": 1
              },
              "input": {
                "$ref": "#/$defs/financialRule.addVersion"
              }
            },
            "required": [
              "id",
              "command",
              "command_version",
              "input"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "command": {
                "const": "financialPrediction.save"
              },
              "command_version": {
                "const": 1
              },
              "input": {
                "$ref": "#/$defs/financialPrediction.save"
              }
            },
            "required": [
              "id",
              "command",
              "command_version",
              "input"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "command": {
                "const": "entry.update"
              },
              "command_version": {
                "const": 1
              },
              "input": {
                "$ref": "#/$defs/entry.update"
              }
            },
            "required": [
              "id",
              "command",
              "command_version",
              "input"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "command": {
                "const": "book.monthlyPlan.save"
              },
              "command_version": {
                "const": 1
              },
              "input": {
                "$ref": "#/$defs/book.monthlyPlan.save"
              }
            },
            "required": [
              "id",
              "command",
              "command_version",
              "input"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "plan_id",
    "book_id",
    "catalog_digest",
    "context_digest"
  ],
  "$defs": {
    "stepReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "output"
      ]
    },
    "account.save": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "openingMinor": {
          "type": "integer"
        },
        "openingDate": {
          "type": "string"
        },
        "account": {
          "anyOf": [
            {
              "x-reference-type": "account",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "$ref": "#/$defs/stepReference"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "CASH",
            "BANK",
            "CREDIT",
            "LOAN",
            "IC"
          ]
        },
        "creditLimit": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "totalMinor": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "installmentMinor": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "revolvingMinor": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sharing": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "TOTAL_ONLY",
                        "SEPARATE_CAPS",
                        "SHARED_SUBPOOL"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "combinedMinor": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "effectiveFrom": {
                  "type": "string"
                },
                "basisDate": {
                  "type": "string"
                },
                "usedTotalMinor": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "usedInstallmentMinor": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "usedRevolvingMinor": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "recovery": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "PAYMENT_DATE",
                        "PLATFORM_CONFIRMATION",
                        "MANUAL"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "usageBasis": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "PRINCIPAL_ONLY",
                        "PLATFORM_ONLY"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "zoneId": {
                  "type": "string"
                },
                "usageStart": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "TRANSACTION_DATE",
                        "ACCOUNT_POSTING_DATE"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "recoveryDelayDays": {
                  "type": "integer"
                }
              },
              "required": [
                "totalMinor",
                "installmentMinor",
                "revolvingMinor",
                "sharing",
                "combinedMinor",
                "effectiveFrom",
                "basisDate",
                "usedTotalMinor",
                "usedInstallmentMinor",
                "usedRevolvingMinor",
                "recovery",
                "usageBasis",
                "zoneId"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "currency",
        "openingMinor",
        "openingDate"
      ]
    },
    "financialRule.addVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "x-reference-type": "account",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
