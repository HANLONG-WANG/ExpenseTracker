    "financialPrediction.save": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "x-reference-type": "account",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/stepReference"
