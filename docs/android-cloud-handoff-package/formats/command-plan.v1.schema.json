              "$ref": "#/$defs/stepReference"
            }
          ]
        },
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "SINGLE",
                "INSTALLMENT",
                "REVOLVING",
                "FIXED_LOAN",
                "CREDIT_LINE"
              ]
            },
            "effectiveFrom": {
              "type": "string"
            },
            "zoneId": {
              "type": "string"
            },
            "billing": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "closingDay": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "closingDayInCurrentBill": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "paymentMonthOffset": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "paymentDay": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "paymentAccountId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": []
                },
                {
                  "type": "null"
                }
              ]
            },
            "installment": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "supportedPeriods": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "feeMethod": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "TOTAL_AMOUNT",
                            "TOTAL_RATE",
                            "PER_HUNDRED_TABLE"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "totalFeeMinor": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "totalRate": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "feeTable": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "periods": {
                            "type": "integer"
                          },
                          "feePerHundred": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "periods",
                          "feePerHundred"
                        ]
                      }
                    },
                    "principalRemainder": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "FIRST",
                            "LAST"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "feeRemainder": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "FIRST",
                            "LAST"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "roundingMode": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": []
                },
                {
                  "type": "null"
                }
              ]
            },
            "revolving": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "interest": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "annualRate": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "frequency": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "DAILY",
                                "MONTHLY"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "balanceBasis": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "EVENT_BALANCE",
                                "OPENING_BALANCE"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "includeStart": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "includeEnd": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "yearDays": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "rounding": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "EACH_DAY",
                                "PERIOD_TOTAL"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "roundingMode": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "firstCharge": {
                          "anyOf": [
                            {
                              "type": "string",
