                        ]
                      }
                    },
                    "tierPaymentIncludesFees": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "allocation": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "FEES_FIRST",
                            "PRINCIPAL_FIRST"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "automatic": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "tierBalanceDate": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
