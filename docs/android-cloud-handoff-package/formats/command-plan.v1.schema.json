                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "includeEnd": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "yearDays": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "rounding": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "EACH_DAY",
                            "PERIOD_TOTAL"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "roundingMode": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "firstCharge": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "NORMAL",
                            "WAIVED"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": []
                },
                {
                  "type": "null"
                }
              ]
            },
            "allocation": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "FEES_FIRST",
                    "PRINCIPAL_FIRST"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "limitRecovery": {
              "anyOf": [
                {
                  "type": "string",
