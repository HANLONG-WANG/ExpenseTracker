              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "EQUAL_PRINCIPAL",
                    "ANNUITY",
                    "INTEREST_ONLY",
                    "MANUAL"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "loanInterest": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "annualRate": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "frequency": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "DAILY",
                            "MONTHLY"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "balanceBasis": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "EVENT_BALANCE",
                            "OPENING_BALANCE"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
