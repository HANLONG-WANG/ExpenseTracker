{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yohaku.local/formats/statement.v1.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "yohaku.statement"
    },
    "version": {
      "const": 1
    },
    "file_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "book_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "account_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "account_currency": {
      "enum": [
        "JPY",
        "CNY",
        "USD"
      ]
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_basis": {
      "enum": [
        "posted_date",
        "occurred_date"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "row_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "direction": {
            "enum": [
              "in",
              "out"
            ]
          },
          "settlement": {
            "type": "object",
            "properties": {
              "currency": {
                "enum": [
                  "JPY",
                  "CNY",
                  "USD"
                ]
              },
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            },
            "required": [
              "currency",
              "amount"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "currency": {
                      "const": "JPY"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "amount": {
                      "pattern": "^(0|[1-9][0-9]*)$"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "currency": {
                      "const": "CNY"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "amount": {
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "currency": {
                      "const": "USD"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "amount": {
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                    }
                  }
                }
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "original": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "currency": {
                    "enum": [
                      "JPY",
                      "CNY",
                      "USD"
                    ]
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  }
                },
                "required": [
                  "currency",
                  "amount"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "currency": {
                          "const": "JPY"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "amount": {
                          "pattern": "^(0|[1-9][0-9]*)$"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "currency": {
                          "const": "CNY"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "amount": {
                          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "currency": {
                          "const": "USD"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "amount": {
                          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "occurred_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "posted_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "time_zone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "fees": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "currency": {
                    "enum": [
                      "JPY",
                      "CNY",
                      "USD"
                    ]
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  }
                },
                "required": [
                  "currency",
                  "amount"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "currency": {
                          "const": "JPY"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "amount": {
                          "pattern": "^(0|[1-9][0-9]*)$"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "currency": {
                          "const": "CNY"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "amount": {
                          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "currency": {
                          "const": "USD"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "amount": {
                          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "exchange_rate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_hint": {
            "anyOf": [
              {
                "enum": [
                  "expense",
                  "income",
                  "transfer",
                  "repayment",
                  "refund",
                  "borrowing"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "row_id",
          "date",
          "direction",
          "settlement",
          "summary"
        ]
      }
    },
    "statement_info": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "principal": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "currency": {
                      "enum": [
                        "JPY",
                        "CNY",
                        "USD"
                      ]
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
