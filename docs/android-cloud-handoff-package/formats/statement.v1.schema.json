                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "JPY"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)$"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "CNY"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "USD"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "fees": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "currency": {
                      "enum": [
                        "JPY",
                        "CNY",
                        "USD"
                      ]
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    }
                  },
                  "required": [
                    "currency",
                    "amount"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "JPY"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)$"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "CNY"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "USD"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "total": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "currency": {
                      "enum": [
                        "JPY",
                        "CNY",
                        "USD"
                      ]
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    }
                  },
                  "required": [
                    "currency",
                    "amount"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "JPY"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)$"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "CNY"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "currency": {
                            "const": "USD"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "amount": {
                            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "payment_date": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": []
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "version",
    "file_id",
    "book_id",
    "account_id",
    "account_currency",
    "from",
    "to",
    "date_basis",
    "complete",
    "source",
    "issues",
    "rows"
  ]
}
