    "/api/v1/tasks/{taskId}/files": {
      "post": {
        "summary": "上传一份原始二进制文件",
        "description": "原始字节而非multipart或Base64；Content-Type也可为实际媒体类型。仅uploading/needs_info状态。每任务最多200个源文件。相同任务/name/SHA重复上传返回已有fileId；没有断点续传。",
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fileId": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "duplicate": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "fileId"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "请求错误",
