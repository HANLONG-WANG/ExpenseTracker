  "components": {
    "securitySchemes": {
      "SitesAccess": {
        "type": "apiKey",
        "in": "header",
        "name": "OAI-Sites-Authorization",
        "description": "值必须为 Bearer <platformAccessToken>。"
      },
      "DeviceAccess": {
        "type": "http",
        "scheme": "bearer",
        "description": "deviceToken，映射到当前所有者。"
      }
    },
    "schemas": {
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "input",
              "result"
            ]
          },
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "role",
          "name",
          "size",
          "sha256"
        ],
        "additionalProperties": true
      },
      "Result": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "inputRevision": {
            "type": "integer"
          },
          "fileId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "ready"
            ]
          },
          "stale": {
            "type": "boolean"
          },
          "validation": {
            "type": "object",
            "properties": {
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "errors",
              "warnings"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "version",
          "inputRevision",
          "fileId",
          "state",
          "stale",
          "validation"
        ],
        "additionalProperties": true
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "receipt",
              "statement",
              "general"
            ]
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploading",
              "queued",
              "analyzing",
              "needs_info",
              "review",
              "ready",
              "archived"
            ]
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          },
          "inputRevision": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "inputRevision",
          "files",
          "results",
          "events"
        ],
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "CreateTask": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "receipt",
              "statement",
              "general"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "instructions": {
            "type": "string",
            "maxLength": 20000
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type",
          "title"
        ],
        "additionalProperties": true
      }
    }
  }
}