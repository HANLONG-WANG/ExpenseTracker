    "accountIconContainer": 44,
    "cardMinHeight": 72,
    "chartMinHeight": 220,
    "chartPreferredHeight": 280,
    "dialogMaxWidth": 560,
    "contentMaxWidth": 720,
    "formMaxWidth": 640,
    "phoneContentHorizontalPadding": 16,
    "phoneCompactHorizontalPadding": 12,
    "bottomActionInset": 88
  },
  "grid": {
    "category": {
      "compactColumns": 3,
      "standardColumns": 4,
      "wideColumns": 5,
      "horizontalGapDp": 8,
      "verticalGapDp": 8,
      "compactBreakpointDp": 360,
      "wideBreakpointDp": 480
    },
    "dashboard": {
      "compactColumns": 1,
      "standardMetricColumns": 2,
      "wideMetricColumns": 2,
      "gapDp": 12
    }
  },
  "breakpointDp": {
    "minimumSupportedWidth": 320,
    "compactMax": 359,
    "standardMin": 360,
    "standardMax": 479,
    "wideMin": 480,
    "largePhoneMin": 600
  },
  "motion": {
    "durationMs": {
      "instant": 0,
      "micro": 80,
      "short": 140,
      "standard": 220,
      "long": 320
    },
    "easing": {
      "standard": [
        0.2,
        0.0,
        0.0,
        1.0
      ],
      "decelerate": [
        0.0,
        0.0,
        0.2,
        1.0
      ],
      "accelerate": [
        0.4,
        0.0,
        1.0,
        1.0
      ]
    },
    "rules": {
      "noDecorativeSpring": true,
      "noCelebrationAnimation": true,
      "reduceMotionUsesFadeOnly": true,
      "reduceMotionMaxDurationMs": 80,
      "skeletonAppearsAfterMs": 150
    }
  },
  "componentPolicy": {
    "featureMayUseDirectly": [
      "Box",
      "Row",
      "Column",
      "FlowRow",
      "LazyColumn",
      "LazyGrid",
      "Canvas",
      "Text with LedgerTheme typography/color"
    ],
    "featureMustUseWrappersFor": [
      "Button",
      "IconButton",
      "TextField",
      "Card",
      "Dialog",
      "BottomSheet",
      "Snackbar",
      "NavigationBar",
      "TopAppBar",
      "Tabs",
      "DatePicker",
      "TimePicker",
      "ProgressIndicator"
    ],
    "forbidden": [
      "hard-coded color literals in feature modules",
      "hard-coded spacing outside documented exceptional layout",
      "feature-local MaterialTheme",
      "feature-local component copies",
      "semantic meaning expressed by color only",
      "custom shadows or gradients outside chart/map tokens",
      "mixed icon families",
      "swipe-to-delete for financial records"
    ]
  }
}