  "typography": {
    "fontFamily": "system-sans",
    "amountHero": {
      "fontSizeSp": 40,
      "lineHeightSp": 48,
      "weight": 600,
      "letterSpacingSp": -0.3,
      "tabularFigures": true
    },
    "amountLarge": {
      "fontSizeSp": 32,
      "lineHeightSp": 40,
      "weight": 600,
      "letterSpacingSp": -0.2,
      "tabularFigures": true
    },
    "amountMedium": {
      "fontSizeSp": 22,
      "lineHeightSp": 28,
      "weight": 600,
      "letterSpacingSp": 0,
      "tabularFigures": true
    },
    "titleLarge": {
      "fontSizeSp": 24,
      "lineHeightSp": 32,
      "weight": 600,
      "letterSpacingSp": 0
    },
    "titleMedium": {
      "fontSizeSp": 20,
      "lineHeightSp": 28,
      "weight": 600,
      "letterSpacingSp": 0
    },
    "titleSmall": {
      "fontSizeSp": 16,
      "lineHeightSp": 24,
      "weight": 600,
      "letterSpacingSp": 0.1
    },
    "bodyLarge": {
      "fontSizeSp": 16,
      "lineHeightSp": 24,
      "weight": 400,
      "letterSpacingSp": 0.2
    },
    "bodyMedium": {
      "fontSizeSp": 14,
      "lineHeightSp": 20,
      "weight": 400,
      "letterSpacingSp": 0.25
    },
    "bodySmall": {
      "fontSizeSp": 12,
      "lineHeightSp": 16,
      "weight": 400,
      "letterSpacingSp": 0.3
    },
    "labelLarge": {
      "fontSizeSp": 14,
      "lineHeightSp": 20,
      "weight": 600,
      "letterSpacingSp": 0.2
    },
    "labelMedium": {
      "fontSizeSp": 12,
      "lineHeightSp": 16,
      "weight": 600,
      "letterSpacingSp": 0.4
    },
    "labelSmall": {
      "fontSizeSp": 11,
      "lineHeightSp": 16,
      "weight": 600,
      "letterSpacingSp": 0.5
    },
    "rules": {
      "amountsUseTabularFigures": true,
      "amountsRightAlignedInLists": true,
      "maxBodyLineLengthDp": 600,
      "doNotUseAllCaps": true,
      "respectSystemFontScale": true,
      "minimumSupportedFontScale": 0.85,
      "testedMaximumFontScale": 2.0
    }
  },
  "spacingDp": {
    "0": 0,
    "1": 2,
    "2": 4,
    "3": 8,
    "4": 12,
    "5": 16,
    "6": 20,
    "7": 24,
    "8": 32,
    "9": 40,
    "10": 48,
    "11": 64
