              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "cardPaymentMonth": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "cardPaymentFeeMinor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
