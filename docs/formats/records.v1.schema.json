                  },
                  "clearingDate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "linkedTransferEventId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "paymentType": {
                    "type": [
                      "string",
                      "null"
