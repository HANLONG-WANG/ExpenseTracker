          "note",
          "revision",
          "accountMinor",
          "accountCurrency",
          "confirmed",
          "historicalIncluded",
          "cardPaymentChoice",
          "cardPaymentPeriods",
          "cardPaymentMonth",
          "cardPaymentFeeMinor"
